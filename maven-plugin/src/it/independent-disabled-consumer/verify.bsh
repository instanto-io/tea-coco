import java.io.File;
import java.nio.file.Files;

File coverageXml = new File(basedir, "target/teavm-coverage.xml");
if (coverageXml.exists()) {
    throw new Exception("Coverage XML must not exist when teacoco.skip=true");
}
File coverageDir = new File(basedir, "target/teavm-coverage");
if (coverageDir.exists()) {
    throw new Exception("Coverage data directory must not exist when teacoco.skip=true");
}

void checkDirectory(File dir) throws Exception {
    File[] files = dir.listFiles();
    if (files != null) {
        for (int i = 0; i < files.length; i++) {
            File f = files[i];
            if (f.isDirectory()) {
                checkDirectory(f);
            } else if (f.getName().endsWith(".js")) {
                String content = Files.readString(f.toPath());
                if (content.contains("__TEA_COCO_JACOCO_V1__") || content.contains("__teavmCoverageV1")) {
                    throw new Exception("JS file should not contain coverage markers when disabled: " + f);
                }
            }
        }
    }
}

File testDir = new File(basedir, "target/teavm-tests");
if (testDir.isDirectory()) {
    checkDirectory(testDir);
}
System.out.println("Verified disabled consumer: no coverage files or probe markers emitted.");
return true;
