<?xml version='1.0' encoding='UTF-8'?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>io.instanto.examples</groupId>
  <artifactId>mockatcha-teacoco-demo</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>Mockatcha and TeaCoCo timesheet example</name>
  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <teavm.version>0.16.0</teavm.version>
    <mockatcha.version>0.1.0-SNAPSHOT</mockatcha.version>
    <teacoco.version>0.1.0-SNAPSHOT</teacoco.version>
    <jvmCoverageArgs />
    <maven.deploy.skip>true</maven.deploy.skip>
  </properties>
  <dependencies>
    <dependency>
      <groupId>io.instanto</groupId>
      <artifactId>mockatcha-core</artifactId>
      <version>${mockatcha.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.instanto</groupId>
      <artifactId>mockatcha-bdd</artifactId>
      <version>${mockatcha.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.teavm</groupId>
      <artifactId>teavm-junit</artifactId>
      <version>${teavm.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.teavm</groupId>
      <artifactId>teavm-classlib</artifactId>
      <version>${teavm.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.teavm</groupId>
      <artifactId>teavm-jso-impl</artifactId>
      <version>${teavm.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <version>4.13.2</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.14.1</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.2</version>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>0.8.15</version>
        <executions>
          <execution>
            <id>jvm-agent</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
            <configuration>
              <propertyName>jvmCoverageArgs</propertyName>
            </configuration>
          </execution>
          <execution>
            <id>jvm-report</id>
            <phase>post-integration-test</phase>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.4</version>
        <configuration>
          <argLine>@{jvmCoverageArgs}</argLine>
          <includes>
            <include>**/*JvmTest.java</include>
          </includes>
        </configuration>
      </plugin>
      <plugin>
        <groupId>io.instanto</groupId>
        <artifactId>teacoco-maven-plugin</artifactId>
        <version>${teacoco.version}</version>
        <configuration><testPlugin>failsafe</testPlugin></configuration>
        <executions>
          <execution>
            <id>prepare-browser</id>
            <phase>pre-integration-test</phase>
            <goals>
              <goal>prepare</goal>
            </goals>
          </execution>
          <execution>
            <id>browser-only-report</id>
            <phase>post-integration-test</phase>
            <goals>
              <goal>report</goal>
            </goals>
            <configuration>
              <outputFile>${project.build.directory}/browser-coverage.xml</outputFile>
            </configuration>
          </execution>
          <execution>
            <id>merged-report</id>
            <phase>post-integration-test</phase>
            <goals>
              <goal>report</goal>
            </goals>
            <configuration>
              <executionData>
                <file>${project.build.directory}/jacoco.exec</file>
              </executionData>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <version>3.5.4</version>
        <executions>
          <execution>
            <id>browser-tests</id>
            <goals>
              <goal>integration-test</goal>
            </goals>
            <configuration>
              <includes>
                <include>**/*BrowserIT.java</include>
              </includes>
              <systemPropertyVariables>
                <teavm.junit.target>${project.build.directory}/teavm-tests</teavm.junit.target>
                <teavm.junit.js>true</teavm.junit.js>
                <teavm.junit.js.runner>browser-chrome</teavm.junit.js.runner>
                <teavm.junit.wasm-gc>false</teavm.junit.wasm-gc>
                <teavm.junit.c>false</teavm.junit.c>
                <teavm.junit.minified>true</teavm.junit.minified>
                <teavm.junit.optimized>true</teavm.junit.optimized>
              </systemPropertyVariables>
            </configuration>
          </execution>
          <execution>
            <id>verify-coverage-parity</id>
            <phase>verify</phase>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
            <configuration>
              <includes>
                <include>**/CoverageParityIT.java</include>
              </includes>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
