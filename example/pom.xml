<?xml version='1.0' encoding='utf-8'?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.instanto</groupId>
    <artifactId>teacoco-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>teacoco-example</artifactId>
  <name>Coverage with the stock TeaVMTestRunner</name>
  <properties>
    <maven.deploy.skip>true</maven.deploy.skip>
    <coverage.enabled>true</coverage.enabled>
    <teacoco.mode>lines</teacoco.mode>
    <coverage.browser>browser-chrome</coverage.browser>
  </properties>
  <dependencies>
    <dependency>
      <groupId>io.instanto</groupId>
      <artifactId>teacoco</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.teavm</groupId>
      <artifactId>teavm-junit</artifactId>
      <version>${teavm.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.teavm</groupId>
      <artifactId>teavm-classlib</artifactId>
      <version>${teavm.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.teavm</groupId>
      <artifactId>teavm-jso-impl</artifactId>
      <version>${teavm.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <version>4.13.2</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <teavm.junit.target>${project.build.directory}/teavm-tests</teavm.junit.target>
            <teavm.junit.js>true</teavm.junit.js>
            <teavm.junit.wasm-gc>false</teavm.junit.wasm-gc>
            <teavm.junit.c>false</teavm.junit.c>
            <teavm.junit.js.runner>${coverage.browser}</teavm.junit.js.runner>
            <teavm.junit.minified>true</teavm.junit.minified>
            <teavm.junit.optimized>true</teavm.junit.optimized>
            <teavm.coverage.enabled>${coverage.enabled}</teavm.coverage.enabled>
            <teavm.coverage.mode>lines</teavm.coverage.mode>
            <teavm.coverage.sourceRoots>${project.basedir}/src/main/java</teavm.coverage.sourceRoots>
            <teavm.coverage.dataDirectory>${project.build.directory}/teavm-coverage</teavm.coverage.dataDirectory>
          </systemPropertyVariables>
        </configuration>
      </plugin>
      <plugin>
        <groupId>io.instanto</groupId>
        <artifactId>teacoco-maven-plugin</artifactId>
        <version>${project.version}</version>
        <executions>
          <execution>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <executions>
          <execution>
            <phase>verify</phase>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
